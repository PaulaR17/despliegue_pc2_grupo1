# Variables de entorno para el despliegue de EcoTraffic.
# Pasos: cp .env.sample .env  y rellena los CAMBIAME con valores reales.
#
# Lo lee tanto docker-compose (para interpolar ${VAR}) como el container
# backend (Laravel) via env_file.

# ----- Base de datos PostgreSQL -----
DB_DATABASE=ecotraffic
DB_USERNAME=ecotraffic
DB_PASSWORD=CAMBIAME

# ----- Laravel -----
APP_NAME=EcoTraffic
APP_ENV=production
APP_DEBUG=false
APP_URL=http://ecotraffic.local

# Genera con:  docker compose run --rm backend php artisan key:generate --show
APP_KEY=CAMBIAME

# Genera con:  docker compose run --rm backend php artisan jwt:secret --show
JWT_SECRET=CAMBIAME

# Drivers en "file" para no necesitar tablas extra en la BD.
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=info

# ----- APIs externas -----
# Open Route Service (geocoder + rutas). Saca la tuya en openrouteservice.org
ORS_API_KEY=CAMBIAME

# AEMET (clima historico para PC1). Saca la tuya en opendata.aemet.es
AEMET_API_KEY=CAMBIAME
